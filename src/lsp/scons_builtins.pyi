# SCons's globals for SConstruct / SConscript files, as builtins: jed hands this to ty in SCons
# workspaces (a root SConstruct) so `Environment`, `Import`, ... aren't "used when not defined".
# Loose types on purpose: SCons is dynamic, and a wrong type would be a false error.

from typing import Any

class Node:
    def __getattr__(self, name: str) -> Any: ...
    def abspath(self) -> str: ...
    def path(self) -> str: ...
    def get_abspath(self) -> str: ...
    def get_path(self, dir: Any = None) -> str: ...
    def srcnode(self) -> Node: ...
    def exists(self) -> bool: ...

class Environment:
    def __init__(self, *args: Any, **kw: Any) -> None: ...
    def __getattr__(self, name: str) -> Any: ...
    def __getitem__(self, key: str) -> Any: ...
    def __setitem__(self, key: str, value: Any) -> None: ...
    def __delitem__(self, key: str) -> None: ...
    def __contains__(self, key: str) -> bool: ...
    def get(self, key: str, default: Any = None) -> Any: ...
    def Dictionary(self, *args: str) -> Any: ...
    def Clone(self, tools: list[str] = ..., toolpath: Any = None, parse_flags: Any = None, **kw: Any) -> Environment: ...
    def Append(self, **kw: Any) -> None: ...
    def AppendUnique(self, delete_existing: bool = False, **kw: Any) -> None: ...
    def AppendENVPath(self, name: str, newpath: Any, envname: str = "ENV", sep: str = ..., delete_existing: bool = False) -> None: ...
    def Prepend(self, **kw: Any) -> None: ...
    def PrependUnique(self, delete_existing: bool = False, **kw: Any) -> None: ...
    def PrependENVPath(self, name: str, newpath: Any, envname: str = "ENV", sep: str = ..., delete_existing: bool = False) -> None: ...
    def Replace(self, **kw: Any) -> None: ...
    def SetDefault(self, **kw: Any) -> None: ...
    def subst(self, string: Any, raw: int = 0, target: Any = None, source: Any = None, conv: Any = None, executor: Any = None, overrides: Any = None) -> str: ...
    def ParseConfig(self, command: Any, function: Any = None, unique: bool = True) -> Any: ...
    def MergeFlags(self, args: Any, unique: bool = True) -> None: ...
    def ParseFlags(self, *flags: Any) -> dict[str, Any]: ...
    def Tool(self, tool: Any, toolpath: Any = None, **kw: Any) -> Any: ...
    def Detect(self, progs: Any) -> str | None: ...
    def WhereIs(self, prog: Any, path: Any = None, pathext: Any = None, reject: Any = None) -> str | None: ...
    def Program(self, target: Any = None, source: Any = None, **kw: Any) -> list[Node]: ...
    def Library(self, target: Any = None, source: Any = None, **kw: Any) -> list[Node]: ...
    def StaticLibrary(self, target: Any = None, source: Any = None, **kw: Any) -> list[Node]: ...
    def SharedLibrary(self, target: Any = None, source: Any = None, **kw: Any) -> list[Node]: ...
    def LoadableModule(self, target: Any = None, source: Any = None, **kw: Any) -> list[Node]: ...
    def Object(self, target: Any = None, source: Any = None, **kw: Any) -> list[Node]: ...
    def StaticObject(self, target: Any = None, source: Any = None, **kw: Any) -> list[Node]: ...
    def SharedObject(self, target: Any = None, source: Any = None, **kw: Any) -> list[Node]: ...
    def Command(self, target: Any, source: Any, action: Any, **kw: Any) -> list[Node]: ...
    def Install(self, dir: Any, source: Any, **kw: Any) -> list[Node]: ...
    def InstallAs(self, target: Any, source: Any, **kw: Any) -> list[Node]: ...
    def Alias(self, alias: Any, targets: Any = None, action: Any = None, **kw: Any) -> list[Node]: ...
    def Default(self, *targets: Any) -> None: ...
    def Depends(self, target: Any, dependency: Any) -> list[Node]: ...
    def Ignore(self, target: Any, dependency: Any) -> list[Node]: ...
    def Requires(self, target: Any, prerequisite: Any) -> None: ...
    def AlwaysBuild(self, *targets: Any) -> list[Node]: ...
    def Clean(self, targets: Any, files: Any) -> None: ...
    def NoClean(self, *targets: Any) -> list[Node]: ...
    def Precious(self, *targets: Any) -> list[Node]: ...
    def SideEffect(self, side_effect: Any, target: Any) -> list[Node]: ...
    def Glob(self, pattern: str, ondisk: bool = True, source: bool = False, strings: bool = False, exclude: Any = None) -> list[Any]: ...
    def Split(self, arg: Any) -> list[str]: ...
    def Dir(self, name: Any, *args: Any, **kw: Any) -> Node: ...
    def File(self, name: Any, *args: Any, **kw: Any) -> Node: ...
    def Entry(self, name: Any, *args: Any, **kw: Any) -> Node: ...
    def Value(self, value: Any, built_value: Any = None, name: Any = None) -> Node: ...
    def Builder(self, **kw: Any) -> Any: ...
    def Action(self, *args: Any, **kw: Any) -> Any: ...
    def Scanner(self, *args: Any, **kw: Any) -> Any: ...
    def Configure(self, *args: Any, **kw: Any) -> Any: ...
    def AddMethod(self, function: Any, name: str | None = None) -> None: ...
    def AddPostAction(self, files: Any, action: Any) -> list[Node]: ...
    def AddPreAction(self, files: Any, action: Any) -> list[Node]: ...
    def Execute(self, action: Any, *args: Any, **kw: Any) -> int: ...
    def SConscript(self, *args: Any, **kw: Any) -> Any: ...
    def VariantDir(self, variant_dir: Any, src_dir: Any, duplicate: bool = True) -> None: ...
    def Decider(self, function: Any) -> None: ...

