#!/bin/sh
# Print the changelog body for a jed release: the tasks completed since the
# previous release, then every commit between them. The release command embeds
# it in the annotated tag message; CI's release job publishes it as the GitHub
# Release notes.
#
# Usage: scripts/changelog [<since> [<until>]]
#   since  the previous release tag; default the highest `v*` tag reachable
#          from `until` that isn't `until` itself (empty on the first release)
#   until  the release being described; default HEAD
set -eu

until=${2:-HEAD}

# The previous release tag, or empty when this is the first release.
if [ "$#" -ge 1 ]; then
    since=$1
else
    since=
    head=$(git rev-parse "$until^{commit}")
    for tag in $(git tag --list 'v*' --merged "$until" --sort=-version:refname); do
        [ "$(git rev-parse "$tag^{commit}")" = "$head" ] && continue
        since=$tag
        break
    done
fi

# Tasks completed since the previous release: scripts/tasks done-since lists
# the tasks whose status flipped to done in the range, as "- **<name>**:
# <summary>" lines. Milestones never appear (they were already done), and
# neither do tasks migrated already-done.
if [ -n "$since" ]; then
    features=$(scripts/tasks done-since "$since" "$until")
else
    features=
fi

echo '## What changed'
if [ -n "$features" ]; then
    echo
    echo "$features"
fi

echo
echo '## Commits'
echo
if [ -n "$since" ]; then
    git log --format='- %s' "$since..$until"
else
    git log --format='- %s' "$until"
fi
