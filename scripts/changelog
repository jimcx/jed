#!/bin/sh
# Print the changelog body for a jed release: the features added to
# docs/plan-done.md since the previous release, then every commit between them.
# The release command embeds it in the annotated tag message; CI's release job
# publishes it as the GitHub Release notes.
#
# Usage: scripts/changelog [<since> [<until>]]
#   since  the previous release tag; default the highest `v*` tag reachable
#          from `until` that isn't `until` itself (empty on the first release)
#   until  the release being described; default HEAD
set -eu

until=${2:-HEAD}

# The previous release tag, or empty when this is the first release.
if [ "$#" -ge 1 ]; then
    since=$1
else
    since=
    head=$(git rev-parse "$until^{commit}")
    for tag in $(git tag --list 'v*' --merged "$until" --sort=-version:refname); do
        [ "$(git rev-parse "$tag^{commit}")" = "$head" ] && continue
        since=$tag
        break
    done
fi

# Features added to docs/plan-done.md since the previous release: the top-level
# "- ✅ **Name** (`id`): summary" (tasks) and "N. ✅ **Name**: ..." (milestones)
# entries, minus the `(id)` and any trailing "— see [...]" link.
if [ -n "$since" ]; then
    features=$(git diff "$since..$until" -- docs/plan-done.md |
        sed -n 's/^+//p' |
        sed -n '/^\(-\|\([0-9][0-9]*\.\)\) ✅ /p' |
        sed 's/^\(-\|\([0-9][0-9]*\.\)\) ✅ //' |
        sed -e 's/^\*\*//' \
            -e 's/\*\* ([^)]*): /: /' \
            -e 's/\*\*: /: /' \
            -e 's/^/- **/' \
            -e 's/: /**: /' \
            -e 's/ — see \[[^]]*\]([^)]*)$//')
else
    features=
fi

echo '## What changed'
if [ -n "$features" ]; then
    echo
    echo "$features"
fi

echo
echo '## Commits'
echo
if [ -n "$since" ]; then
    git log --format='- %s' "$since..$until"
else
    git log --format='- %s' "$until"
fi
