#!/bin/sh
# Atomically land a finished task branch onto main. Replays <branch> onto
# main's current tip, then moves main with `git update-ref`'s compare-and-swap
# (only if main still points where we rebased onto), so two tasks landing at
# once can't interleave — the loser replays and retries. A real conflict stops
# with a message rather than looping.
#
# Run from the branch's own worktree (it must be checked out and clean), or
# from the main checkout. On success the branch is deleted and the checkout is
# left on main.
#
# Usage: scripts/land <branch>
set -e

branch=$1
[ -n "$branch" ] || { echo "usage: scripts/land <branch>" >&2; exit 2; }

while :; do
    old=$(git rev-parse main)
    base=$(git merge-base "$branch" "$old")
    if ! git rebase --onto "$old" "$base" "$branch"; then
        echo "scripts/land: conflict replaying $branch onto main (resolve, then retry)" >&2
        git rebase --abort 2>/dev/null || true
        exit 1
    fi
    new=$(git rev-parse "$branch")
    if git update-ref -m "land $branch" refs/heads/main "$new" "$old"; then
        # The checkout may now be on $branch; move it back to main before deleting.
        git checkout -q main 2>/dev/null || git checkout -q --detach main
        git branch -d "$branch"
        echo "landed $branch onto main ($new)"
        exit 0
    fi
    # main moved while we were replaying — loop and replay again.
done
