#!/usr/bin/env python3
"""Expand a Hunspell dictionary (en_AU.dic + en_AU.aff) into assets/dictionaries/en_AU.txt.

Dev-time only (the binary just include_str!s the result): sorted, de-duplicated, lower-cased,
one word per line. Handles the plain one-character flag format and FLAG long / num / UTF-8;
PFX / SFX rules with conditions, strip and cross products (one affix level, which is what
SCOWL-derived en_AU uses). Words with NEEDAFFIX / ONLYINCOMPOUND / NOSUGGEST-style flags are
left out. Proper nouns are kept (lower-cased: the checker matches case-insensitively).

    scripts/gen-dictionary en_AU.dic en_AU.aff > assets/dictionaries/en_AU.txt

Source and licence: assets/dictionaries/README.md.
"""
import re
import sys


def read_aff(path):
    flag_mode = "single"
    rules = {}  # flag -> (kind, cross, [(strip, add, cond_re)])
    specials = {}
    with open(path, encoding="utf-8", errors="replace") as f:
        lines = [l.split("#")[0].rstrip("\n") if not l.startswith(("PFX", "SFX")) else l.rstrip("\n") for l in f]
    i = 0
    while i < len(lines):
        parts = lines[i].split()
        i += 1
        if not parts:
            continue
        if parts[0] == "FLAG" and len(parts) > 1:
            flag_mode = parts[1].lower()
        elif parts[0] in ("NEEDAFFIX", "ONLYINCOMPOUND", "NOSUGGEST", "FORBIDDENWORD", "PSEUDOROOT") and len(parts) > 1:
            specials[parts[0]] = parts[1]
        elif parts[0] in ("PFX", "SFX") and len(parts) >= 4 and parts[3].isdigit():
            kind, flag, cross, count = parts[0], parts[1], parts[2] == "Y", int(parts[3])
            entries = []
            for _ in range(count):
                p = lines[i].split()
                i += 1
                strip = "" if p[2] == "0" else p[2]
                add = p[3].split("/")[0]
                add = "" if add == "0" else add
                cond = p[4] if len(p) > 4 else "."
                rx = re.compile(("^" if kind == "PFX" else "") + cond + ("" if kind == "PFX" else "$"))
                entries.append((strip, add, rx))
            rules[flag] = (kind, cross, entries)
    return flag_mode, rules, specials


def split_flags(s, mode):
    if mode == "long":
        return [s[j : j + 2] for j in range(0, len(s), 2)]
    if mode == "num":
        return [x for x in s.split(",") if x]
    return list(s)


def apply(word, rule):
    kind, _cross, entries = rule
    out = []
    for strip, add, rx in entries:
        if not rx.search(word):
            continue
        if kind == "SFX":
            if strip and not word.endswith(strip):
                continue
            out.append(word[: len(word) - len(strip)] + add)
        else:
            if strip and not word.startswith(strip):
                continue
            out.append(add + word[len(strip) :])
    return out


def main():
    dic, aff = sys.argv[1], sys.argv[2]
    mode, rules, specials = read_aff(aff)
    skip = {v for k, v in specials.items() if k != "PSEUDOROOT"}
    words = set()
    with open(dic, encoding="utf-8", errors="replace") as f:
        next(f)  # entry count
        for line in f:
            line = line.strip()
            if not line or line.startswith("#"):
                continue
            word, _, rest = line.partition("/")
            flags = split_flags(rest.split()[0], mode) if rest else []
            word = word.split()[0]
            if any(fl in skip for fl in flags):
                continue
            words.add(word)
            sfx = [apply(word, rules[fl]) for fl in flags if fl in rules and rules[fl][0] == "SFX"]
            pfx = [(fl, apply(word, rules[fl])) for fl in flags if fl in rules and rules[fl][0] == "PFX"]
            for forms in sfx:
                words.update(forms)
            for _fl, forms in pfx:
                words.update(forms)
            # cross products (prefix + suffix forms) for rules marked Y
            for fl, _ in pfx:
                if not rules[fl][1]:
                    continue
                for sfl in flags:
                    if sfl in rules and rules[sfl][0] == "SFX" and rules[sfl][1]:
                        for sform in apply(word, rules[sfl]):
                            words.update(apply(sform, rules[fl]))
    # The checker accepts any listed word + "'s", so those forms are not listed.
    words = {w.replace("\u2019", "'") for w in words}
    words = {w for w in words if not w.endswith("'s")}
    out = sorted({w.lower() for w in words if w and re.fullmatch(r"[^\W\d_]+(?:'[^\W\d_]+)*", w.lower())})
    sys.stdout.write("\n".join(out) + "\n")


if __name__ == "__main__":
    main()
